{
  "name": "LUMA — Premium Streaming",
  "short_name": "LUMA",
  "description": "Watch movies, series, and anime from multiple sources. Free, ad-supported, and privacy-first streaming.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0a0a0f",
  "theme_color": "#0a0a0f",
  "lang": "en-US",
  "categories": ["entertainment", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/splash.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "LUMA Home Screen"
    },
    {
      "src": "/icons/splash.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "wide",
      "label": "LUMA Desktop View"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Content",
      "short_name": "Browse",
      "description": "Browse all movies and TV shows",
      "url": "/?source=pwa#/browse",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search for movies and series",
      "url": "/?source=pwa#/search",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Favorites",
      "short_name": "Favorites",
      "description": "View your saved favorites",
      "url": "/?source=pwa#/favorites",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/#/search",
    "method": "GET",
    "params": {
      "text": "q",
